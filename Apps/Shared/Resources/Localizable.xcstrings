          "stringUnit": {
            "state": "translated",
            "value": "特徴の距離は確信度のパーセントではありません。小さい値は表現が近いことを示しますが、重複を保証しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "特征距离不是置信度百分比。数值较小表示特征更接近，不保证照片重复。"
          }
        }
      }
