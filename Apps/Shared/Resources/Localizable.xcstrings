        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シーンの視覚的特徴が近くても、表情、動き、被写体が異なる場合があります。重複の証明ではありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "视觉场景特征接近，但帧内可能有不同表情、动作或对象；这不是重复的证明。"
          }
        }
      }
    },
