  "strings": {
    "app_1_duplicate_group_to_review": {
      "comment": "LibraryView.swift: 1 duplicate group to review",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1 duplicate group to review"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認待ちの重複グループが1件あります"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1 组重复照片待核对"
          }
        }
      }
    },
    "app_1_local_change_region": {
      "comment": "PhotoDifferenceView.swift: 1 Local Change Region",
      "extractionState": "manual",
      "localizations": {
        "en": {
