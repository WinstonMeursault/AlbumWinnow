          }
        }
      }
    },
    "app_photos_are_linked_by_relative_image_position_not_pixel_alignment_crops_and_different_viewpoints_may_show_different_objects_detail_previews_are_limited_to_available_pixels_and_do_not_silently_download_from_icloud": {
      "comment": "ReviewToolsView.swift: Photos are linked by relative image position, not pixel alignment. Crops and different viewpoints may show different objects. Detail previews are limited to available pixels and do not silently download from iCloud.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos are linked by relative image position, not pixel alignment. Crops and different viewpoints may show different objects. Detail previews are limited to available pixels and do not silently download from iCloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真は画像内の相対位置で連動し、ピクセル単位で位置合わせするものではありません。切り抜きや視点の違いで別の被写体が表示される場合があります。詳細表示は利用可能な画素数に制限され、iCloudから無断でダウンロードすることはありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片按图像内的相对位置联动，并非像素对齐。裁剪和不同视角可能显示不同对象。细节预览受可用像素限制，不会静默从 iCloud 下载。"
          }
        }
      }
    },
