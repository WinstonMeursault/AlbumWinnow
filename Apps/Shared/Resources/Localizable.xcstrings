    "app_the_summary_uses_the_most_cautious_category_each_member_below_records_its_own_match_to_the_reference_photo_not_to_every_other_member": {
      "comment": "ReviewToolsView.swift: The summary uses the most cautious category. Each member below records its own match to the reference photo, not to every other member.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The summary uses the most cautious category. Each member below records its own match to the reference photo, not to every other member."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "概要には最も慎重な分類を使います。各写真の情報は比較元との関係であり、すべての写真同士の一致を示すものではありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "摘要采用最谨慎的类别。下列每张照片记录的是与参照照片的匹配关系，并非与其他所有成员的关系。"
          }
        }
      }
    },
    "app_there_is_not_enough_stable_detail_to_verify_alignment_inspect_the_photos_with_synchronized_zoom_in_the_group": {
      "comment": "PhotoDifferenceView.swift: There is not enough stable detail to verify alignment. Inspect the photos with synchronized zoom in the group.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is not enough stable detail to verify alignment. Inspect the photos with synchronized zoom in the group."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置合わせを検証できる安定した細部が不足しています。グループ内の同期拡大で確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "稳定细节不足，无法验证对齐。请在组内同步放大核对照片。"
          }
        }
      }
    },
    "app_these_are_approximate_image_change_hints_from_previews_up_to_512_pixels_with_global_color_and_compression_noise_suppressed_small_details_can_be_missed_use_synchronized_zoom_in_the_group_to_inspect_originals_hints_do_not_change_matching_recommendations_or_cleanup_choices": {
      "comment": "PhotoDifferenceView.swift: These are approximate image-change hints from previews up to 512 pixels, with global color and compression noise suppressed. Small details can be missed. Use synchronized zoom in the group to inspect originals. Hints do not change matching, recommendations or cleanup choices.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These are approximate image-change hints from previews up to 512 pixels, with global color and compression noise suppressed. Small details can be missed. Use synchronized zoom in the group to inspect originals. Hints do not change matching, recommendations or cleanup choices."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長辺512ピクセル以下のプレビューから、全体的な色の変化と圧縮ノイズを抑えて検出した、おおよその画像の変化です。細部を見落とす場合があります。グループ内の同期拡大で元の画像を確認してください。この表示は一致判定、推奨、整理対象の選択に影響しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些是基于最长边不超过 512 像素的预览生成的近似图像变化提示，已抑制全局颜色变化和压缩噪声。细微差异可能漏检。请在组内同步放大检查原图。提示不改变匹配、推荐或清理选择。"
          }
        }
      }
    },
    "app_these_measured_thumbnail_signals_do_not_establish_subject_focus_artistic_intent_or_aesthetic_quality": {
      "comment": "ReviewToolsView.swift: These measured thumbnail signals do not establish subject focus, artistic intent or aesthetic quality.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These measured thumbnail signals do not establish subject focus, artistic intent or aesthetic quality."
