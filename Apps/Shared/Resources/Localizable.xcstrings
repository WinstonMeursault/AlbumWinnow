    "app_visual_features_agree_within_this_group_a_shared_burst_identifier_and_capture_time_proximity_are_candidate_hints_not_proof_of_identical_content": {
      "comment": "ReviewToolsView.swift: Visual features agree within this group. A shared burst identifier and capture-time proximity are candidate hints, not proof of identical content.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Visual features agree within this group. A shared burst identifier and capture-time proximity are candidate hints, not proof of identical content."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グループ内の視覚的特徴が近いことを示します。同じ連写IDや近い撮影時刻は候補を探す手掛かりであり、内容が同一である証明ではありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本组的视觉特征接近。共同连拍标识和拍摄时间邻近仅用于查找候选，并非内容相同的证明。"
          }
        }
      }
    },
    "app_visual_scene_features_are_close_frames_may_contain_different_expressions_movement_or_objects_this_is_not_duplicate_proof": {
