    "app_groups_require_every_member_to_agree_with_the_representative_and_the_other_members_with_at_most_24_photos_larger_scenes_and_similarity_chains_can_be_split_low_texture_photos_may_be_omitted": {
      "comment": "ReviewToolsView.swift: Groups require every member to agree with the representative and the other members, with at most 24 photos. Larger scenes and similarity chains can be split. Low-texture photos may be omitted.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Groups require every member to agree with the representative and the other members, with at most 24 photos. Larger scenes and similarity chains can be split. Low-texture photos may be omitted."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各写真は代表画像および他の全写真との一致条件を満たす必要があり、1グループは最大24枚です。大きなシーンや類似の連鎖は分割され、模様の少ない写真は対象外になる場合があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个成员必须与代表图及其他成员保持一致，每组最多 24 张。较大的场景和相似链条可能拆分，低纹理照片可能被省略。"
          }
        }
      }
    },
