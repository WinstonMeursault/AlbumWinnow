    "app_cross_side_evidence_only_unmatched_members_remain_kept": {
      "comment": "GroupReviewView.swift: Cross-side evidence only; unmatched members remain kept.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cross-side evidence only; unmatched members remain kept."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "比較の根拠は両側間の一致のみです。一致を確認できない写真は残します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅采用两侧之间的匹配依据；没有匹配依据的成员仍会保留。"
          }
        }
      }
    },
    "app_cross_side_mode_uses_only_matches_between_the_two_sources_it_may_keep_extra_photos_when_a_selected_copy_has_no_verified_match_to_another_member": {
      "comment": "ScanPolicySettings.swift: Cross-side mode uses only matches between the two sources. It may keep extra photos when a selected copy has no verified match to another member.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cross-side mode uses only matches between the two sources. It may keep extra photos when a selected copy has no verified match to another member."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両側の比較では、2つのソース間の一致だけを使います。選んだコピーと他の写真の一致を検証できない場合は、追加の写真も残すことがあります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两侧模式仅采用两个来源之间的匹配。当所选副本与其他成员没有经过验证的匹配时，可能额外保留照片。"
          }
        }
      }
    },
    "app_dates_use_the_latest_known_capture_metadata_in_each_group_unknown_dates_stay_last_in_either_direction_size_sorting_uses_known_candidate_bytes_partial_sizes_are_lower_bounds": {
      "comment": "ReviewToolsView.swift: Dates use the latest known capture metadata in each group. Unknown dates stay last in either direction. Size sorting uses known candidate bytes; partial sizes are lower bounds.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dates use the latest known capture metadata in each group. Unknown dates stay last in either direction. Size sorting uses known candidate bytes; partial sizes are lower bounds."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日付にはグループ内の最新の既知の撮影情報を使います。日付不明のグループは常に最後です。サイズ順は候補の既知のバイト数に基づき、一部不明の場合は下限値です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日期采用每组最新的已知拍摄元数据。无论升序或降序，日期未知的组均置后。大小排序使用候选的已知字节数，部分已知的大小为下限。"
          }
        }
      }
    },
