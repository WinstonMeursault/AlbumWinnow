    "app_double_tap_or_double_click_a_photo_to_zoom_or_reset_use_the_group_menu_for_zoom_in_reset_zoom_and_sync_zoom_dragging_while_zoomed_pans_the_image_instead_of_changing_groups": {
      "comment": "ReviewToolsView.swift: Double-tap or double-click a photo to zoom or reset. Use the group menu for Zoom In, Reset Zoom and Sync Zoom. Dragging while zoomed pans the image instead of changing groups.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Double-tap or double-click a photo to zoom or reset. Use the group menu for Zoom In, Reset Zoom and Sync Zoom. Dragging while zoomed pans the image instead of changing groups."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真をダブルタップまたはダブルクリックすると拡大・リセットできます。グループのメニューからも拡大、リセット、同期を選べます。拡大中のドラッグは画像の移動になり、グループは切り替わりません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "双击照片可放大或复位。组内菜单提供放大、复位和同步缩放。放大后拖动只平移图像，不翻组。"
          }
        }
      }
    },
