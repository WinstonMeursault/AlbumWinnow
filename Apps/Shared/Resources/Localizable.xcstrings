    "app_read_only_sources_participate_in_comparison_but_cannot_be_cleaned_locks_and_associated_resources_remain_protected_hardlinked_files_may_be_kept_conservatively_while_a_folder_is_read_only": {
      "comment": "ScanPolicySettings.swift: Read-only sources participate in comparison but cannot be cleaned. Locks and associated resources remain protected. Hardlinked files may be kept conservatively while a folder is read-only.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read-only sources participate in comparison but cannot be cleaned. Locks and associated resources remain protected. Hardlinked files may be kept conservatively while a folder is read-only."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み取り専用ソースも比較に含めますが、整理はできません。ロックと関連リソースの保護は維持されます。読み取り専用フォルダがある場合、ハードリンクのファイルを安全のため残すことがあります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只读来源参与比较，但不允许清理。锁定和关联资源仍受保护。文件夹为只读时，硬链接文件可能被保守地保留。"
          }
        }
      }
    },
