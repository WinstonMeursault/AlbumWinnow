          }
        }
      }
    },
    "app_a_local_preview_is_unavailable_download_and_rescan_from_the_group_menu_before_comparing_again": {
      "comment": "PhotoDifferenceView.swift: A local preview is unavailable. Download and rescan from the group menu before comparing again.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A local preview is unavailable. Download and rescan from the group menu before comparing again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルのプレビューを取得できません。グループのメニューでダウンロードして再スキャンした後に比較してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地预览不可用。请从组内菜单下载并重新扫描，再进行比较。"
          }
        }
      }
    },
    "app_a_saved_folder_is_unavailable_select_it_again_to_restore_access": {
      "comment": "ReviewModel.swift: A saved folder is unavailable. Select it again to restore access.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A saved folder is unavailable. Select it again to restore access."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済みのフォルダにアクセスできません。もう一度選択してアクセスを復元してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存的某个文件夹无法访问，请重新选择以恢复访问权限。"
          }
        }
      }
    },
    "app_a_thumbnail_edge_contrast_tie_break_is_used_this_is_not_a_calibrated_sharpness_comparison": {
      "comment": "ReviewToolsView.swift: A thumbnail edge-contrast tie-break is used. This is not a calibrated sharpness comparison.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A thumbnail edge-contrast tie-break is used. This is not a calibrated sharpness comparison."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同等の場合にサムネイルの輪郭コントラストを使っています。校正された鮮明さの比較ではありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "采用缩略图边缘对比度来打破并列。这不是经过校准的清晰度比较。"
          }
        }
      }
    },
