    "app_adds_a_separate_similar_photos_queue_and_includes_accessible_burst_members_natural_photo_accuracy_has_not_been_measured_duplicate_checks_and_cleanup_confirmation_remain_separate": {
      "comment": "ScanSourcesView.swift: Adds a separate Similar Photos queue and includes accessible burst members. Natural-photo accuracy has not been measured. Duplicate checks and cleanup confirmation remain separate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds a separate Similar Photos queue and includes accessible burst members. Natural-photo accuracy has not been measured. Duplicate checks and cleanup confirmation remain separate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセスできる連写写真を含めた専用の類似写真一覧を追加します。自然写真での精度は未測定です。重複判定と整理の確認は別に行います。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "增加独立的相似照片队列，并包含可访问的连拍成员。尚未测量自然照片准确率。重复检查与清理确认保持独立。"
          }
        }
      }
    },
    "app_adds_the_entire_group_to_pending_cleanup": {
      "comment": "GroupReviewView.swift: Adds the entire group to pending cleanup",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds the entire group to pending cleanup"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グループ全体を整理待ちに追加します"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将整组加入待清理候选"
          }
        }
      }
    },
