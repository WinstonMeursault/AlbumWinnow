      "comment": "ReviewToolsView.swift: More measured thumbnail edge energy at the same image dimensions and comparable exposure. Check subject focus manually; intentional blur can be appropriate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More measured thumbnail edge energy at the same image dimensions and comparable exposure. Check subject focus manually; intentional blur can be appropriate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ画像サイズと近い露出で、サムネイルの輪郭エネルギーが高く測定されました。被写体のピントは手動で確認してください。意図的なぼかしが適切な場合もあります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在尺寸相同、曝光接近时，测得更高的缩略图边缘能量。请人工检查主体对焦；有意的虚焦也可能合适。"
          }
        }
      }
    },
    "app_more_pixels_than_another_copy_arg1_arg2_resolution_alone_does_not_establish_sharpness": {
      "comment": "ReviewToolsView.swift: More pixels than another copy ({arg1} × {arg2}). Resolution alone does not establish sharpness.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
