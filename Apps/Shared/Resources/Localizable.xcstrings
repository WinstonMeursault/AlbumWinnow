    "app_recommended_is_a_suggestion_selected_is_your_keep_choice_locked_photos_must_also_remain_a_lock_is_not_a_quality_rating": {
      "comment": "ReviewToolsView.swift: Recommended is a suggestion. Selected is your keep choice. Locked photos must also remain; a lock is not a quality rating.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recommended is a suggestion. Selected is your keep choice. Locked photos must also remain; a lock is not a quality rating."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「推奨」は提案、「残す写真に選択」はあなたの選択です。ロックした写真も必ず残します。ロックは品質の評価ではありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“建议保留”只是建议，“已选保留”是你的选择。已锁定的照片也必须保留；锁定不是质量评级。"
          }
        }
      }
    },
