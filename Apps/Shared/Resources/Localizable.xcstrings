    "app_only_cross_side_edges_are_evidence_photos_on_the_same_side_are_not_assumed_identical_choosing_one_photo_may_retain_additional_members_without_a_verified_match_to_a_retained_photo": {
      "comment": "ReviewToolsView.swift: Only cross-side edges are evidence. Photos on the same side are not assumed identical. Choosing one photo may retain additional members without a verified match to a retained photo.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only cross-side edges are evidence. Photos on the same side are not assumed identical. Choosing one photo may retain additional members without a verified match to a retained photo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "根拠にするのは両側間の一致のみで、同じ側の写真が同一とは見なしません。1枚を残すよう選択しても、残す写真との一致を検証できない他の写真は残る場合があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅两侧之间的匹配关系作为依据，不假定同侧照片相同。选择保留一张后，与保留照片没有已验证匹配关系的其他成员也可能继续保留。"
          }
        }
      }
    },
