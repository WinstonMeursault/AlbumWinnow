    "app_albums_are_unavailable_with_limited_photo_access_review_access_or_choose_all_accessible_photos_explicitly": {
      "comment": "ScanPolicySettings.swift: Albums are unavailable with limited photo access. Review access or choose all accessible photos explicitly.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Albums are unavailable with limited photo access. Review access or choose all accessible photos explicitly."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真へのアクセスが制限されている場合、アルバムは利用できません。権限を確認するか、アクセス可能なすべての写真を明示的に選んでください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有限照片权限下无法使用相册。请检查访问权限，或明确选择全部可访问照片。"
          }
        }
      }
    },
    "app_albums_could_not_be_loaded_existing_selections_are_preserved": {
      "comment": "ScanPolicySettings.swift: Albums could not be loaded. Existing selections are preserved.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Albums could not be loaded. Existing selections are preserved."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アルバムを読み込めませんでした。現在の選択は保持しています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法加载相册，已保留现有选择。"
          }
        }
      }
    },
