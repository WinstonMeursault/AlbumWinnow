    "app_multiple_albums_form_a_union_empty_selection_scans_no_photos_unavailable_selections_never_fall_back_to_the_whole_library": {
      "comment": "ScanPolicySettings.swift: Multiple albums form a union. Empty selection scans no photos; unavailable selections never fall back to the whole library.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Multiple albums form a union. Empty selection scans no photos; unavailable selections never fall back to the whole library."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "複数のアルバムはまとめて扱います。未選択なら写真はスキャンしません。選択したアルバムが使えなくても、ライブラリ全体のスキャンには切り替えません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "多个相册采用并集。空选择不扫描任何照片；所选相册不可用时，不会退回扫描整个图库。"
          }
        }
      }
    },
